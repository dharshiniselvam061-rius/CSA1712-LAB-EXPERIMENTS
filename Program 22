check_flight(Bird) :-
    can_fly(Bird),
    write(Bird),
    write(' can fly.').

check_flight(Bird) :-
    cannot_fly(Bird),
    write(Bird),
    write(' cannot fly.').

check_flight(Bird) :-
    bird(Bird),
    \+ can_fly(Bird),
    \+ cannot_fly(Bird),
    write('Flight information is unknown.').
